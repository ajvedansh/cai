APP_ENV=development
PORT=3003
REDIS_URL=redis://:cai_redis_local@localhost:6379

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set USE_ANTHROPIC=true and add your API key to use Claude (paid).
# Leave USE_ANTHROPIC=false to use Ollama (free, runs locally).
USE_ANTHROPIC=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Ollama (local LLaMA) settings — used when USE_ANTHROPIC=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Pipeline ──────────────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.85
STREAM_MESSAGE_RECEIVED=cai:message.received
STREAM_TRADE_CALL_CREATED=cai:trade_call.created
STREAM_NEEDS_REVIEW=cai:message.needs_review
CONSUMER_GROUP=signal-parser-group
CONSUMER_NAME=signal-parser-1

API_KEY=dev-api-key-change-in-prod
